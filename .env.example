# Copy this file to .env and fill it in. Never commit the .env file.

# Admin panel login (at /admin). The password must be at least 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Port on this machine that nginx listens on. On the OSSC server 8094 is reserved for this site
# (see docs/deploy-ossc-server.md for the ports already in use). It is published on 127.0.0.1 only;
# the Cloudflare tunnel connects to it.
HOST_PORT=8094
# HOST_BIND=0.0.0.0   # only to reach the site directly from the network, without the tunnel

# Optional starting values for the UPI account that collects the fee.
# These can be changed any time from the admin panel (Settings), which takes priority once saved.
UPI_ID=
UPI_NAME=Ideathon 26

# Upload limits, in megabytes.
MAX_SCREENSHOT_MB=3
MAX_STATEMENT_MB=5

# Virus scanning (ClamAV runs as its own container).
# false: if the scanner is down, uploads are still accepted, re-encoded, and marked "not scanned".
# true:  if the scanner is down, uploads are refused until it is back.
SCAN_REQUIRED=false

# Outgoing email over SMTP: verification codes, and "received / confirmed / rejected" emails.
# Leave SMTP_HOST empty to run without email.
#
# Gmail example: create an "App password" for the account (Google Account > Security > 2-Step
# Verification > App passwords) and use it as SMTP_PASS. Your normal Gmail password will not work.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=ideathon.dbit@gmail.com
#   SMTP_PASS=the-16-character-app-password
#   MAIL_FROM=Ideathon 26 <ideathon.dbit@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for port 465, leave empty for 587.
SMTP_SECURE=
MAIL_FROM=
# Set this to the mail server's name when the mail server, or a cloudflared tunnel to it, runs on
# this machine (the OSSC setup). Leave empty for a mail provider on the internet such as Gmail.
#
# OSSC mail server (mail.webuildnow.in). The sender must be a webuildnow.in address.
#   On the OSSC server:   SMTP_PORT=587   SMTP_ON_THIS_HOST=mail.webuildnow.in
#   On a laptop:          SMTP_PORT=1587  SMTP_ON_THIS_HOST=mail.webuildnow.in
#                         and keep this running:
#                         cloudflared access tcp --hostname smtp-tunnel.webuildnow.in --url localhost:1587
SMTP_ON_THIS_HOST=
# Stay under your provider's quota (a free Gmail account allows about 500 emails a day).
MAIL_DAILY_LIMIT=400
