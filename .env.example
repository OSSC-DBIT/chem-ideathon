# Ideathon '26 registration site: server settings.
#
# Copy this file to .env and fill it in:   cp .env.example .env && chmod 600 .env
# Never commit .env. After changing it, apply with:   docker compose up -d
#
# Only the two values under "Required" must be set. Everything else has a working default.
# Every setting is explained in docs/configuration.md.


# ============================================================================
# Required
# ============================================================================

# Password of the owner account for the admin panel (/admin). At least 12 characters.
# Organisers get their own accounts from the admin panel; do not share this one.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Encryption key for everything stored on disk: the database and the payment screenshots.
# At least 32 characters. Generate one with either of:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# KEEP A COPY OF THIS KEY SOMEWHERE SAFE AND SEPARATE FROM THE SERVER (a password manager).
# Without it the data cannot be read, by anyone, ever. A backup is useless without it.
DATA_KEY=

# Only while changing the key: put the old key here and the new key in DATA_KEY, start once,
# then clear this line. See docs/operations.md.
DATA_KEY_OLD=


# ============================================================================
# Network
# ============================================================================

# Port on this machine that nginx listens on. On the OSSC server 8094 is reserved for this site
# (docs/deploy-ossc-server.md lists the ports already in use).
HOST_PORT=8094

# The port is published on 127.0.0.1 only, for the Cloudflare tunnel on the same machine.
# Uncomment to reach the site directly from the network, without the tunnel.
# HOST_BIND=0.0.0.0


# ============================================================================
# Email: verification codes, and "received / confirmed / rejected" emails
# ============================================================================
# Leave SMTP_HOST empty to run without email. Email verification then cannot be switched on.
# After setting it up, use "Check connection" and "Send test" on the Student list tab.

# --- OSSC mail server (mail.webuildnow.in) ---------------------------------
# The sender must be a webuildnow.in address; mail sent as @dbit.co.in is dropped by Gmail.
#   SMTP_HOST=mail.webuildnow.in
#   SMTP_USER=<mailbox login, ask the mail admin>
#   SMTP_PASS=<mailbox password>
#   MAIL_FROM=Ideathon 26 <mailbox@webuildnow.in>
#   SMTP_ON_THIS_HOST=mail.webuildnow.in
#   On the OSSC server:  SMTP_PORT=587
#   On a laptop:         SMTP_PORT=1587, and keep this running in a terminal:
#                        cloudflared access tcp --hostname smtp-tunnel.webuildnow.in --url localhost:1587
#
# --- Gmail or another provider on the internet ------------------------------
# Gmail needs an "App password" (Google Account > Security > 2-Step Verification > App passwords).
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=the-16-character-app-password
#   MAIL_FROM=Ideathon 26 <you@gmail.com>
#   (leave SMTP_ON_THIS_HOST empty)

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# true for port 465. Leave empty for 587 (the connection is upgraded with STARTTLS).
SMTP_SECURE=

# The mail server's name, when that server (or a cloudflared tunnel to it) runs on this machine.
# Leave empty for a provider on the internet.
SMTP_ON_THIS_HOST=

# The site stops sending after this many emails in a day, to stay under the provider's quota.
MAIL_DAILY_LIMIT=400


# ============================================================================
# Payment
# ============================================================================
# Starting values only. The UPI ID saved in the admin panel (Settings) wins once it is set there.
UPI_ID=
UPI_NAME=Ideathon 26


# ============================================================================
# Uploads and virus scanning
# ============================================================================

# Size limits in megabytes: the payment screenshot, and a bank statement or student list file.
MAX_SCREENSHOT_MB=3
MAX_STATEMENT_MB=5

# What happens to uploads while the virus scanner is unavailable (for example just after a restart):
#   false: accepted, cleaned by re-encoding, and marked "not virus scanned"
#   true:  refused until the scanner is back
SCAN_REQUIRED=false


# ============================================================================
# Rate limits (optional)
# ============================================================================
# Per visitor address. The defaults are sized for a whole campus sharing one address. Raise them
# if students still see "Too many requests". Leave empty for the defaults shown.

# All API calls together, per minute. Default 6000.
API_RATE_LIMIT=
# Registration submissions per 10 minutes. Default 400.
REGISTER_RATE_LIMIT=
# Requests for a verification email per 10 minutes. Default 300.
VERIFY_SEND_RATE_LIMIT=
